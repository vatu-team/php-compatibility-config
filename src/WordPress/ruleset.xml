<?xml version="1.0"?>
<ruleset
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	name="Vatu-WordPress"
	xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd">

	<!--
		WordPress (https://wordpress.org)
	-->

	<rule ref="PHPCompatibilityWP"/>

		<rule ref="PHPCompatibility.Constants.RemovedConstants.intl_idna_variant_2003DeprecatedRemoved">
			<!-- For Backwards Compatibility with PHP < 8.0. -->
			<exclude-pattern>*\/wp-includes\/PHPMailer\/PHPMailer\.php$</exclude-pattern>
		</rule>

	<rule ref="PHPCompatibility.FunctionUse.RemovedFunctions.imap_rfc822_parse_adrlistRemoved">
		<!-- For Backwards Compatibility with PHP < 8.4. -->
		<exclude-pattern>*\/wp-includes\/PHPMailer\/PHPMailer\.php$</exclude-pattern>
	</rule>

	<rule ref="PHPCompatibility.FunctionUse.RemovedFunctions.imap_errorsRemoved">
		<!-- For Backwards Compatibility with PHP < 8.4. -->
		<exclude-pattern>*\/wp-includes\/PHPMailer\/PHPMailer\.php$</exclude-pattern>
	</rule>

</ruleset>
